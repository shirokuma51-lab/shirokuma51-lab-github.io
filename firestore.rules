rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.uid == 'i6GOrjireVa7gTM2IL8lLxvl5Zd2'; }
    function image(s) { return s is string && (s.matches('assets/images/[a-zA-Z0-9_-]+[.](png|webp|jpg)') || s.matches('upload:slot([0-9]|[1-4][0-9]):[a-zA-Z0-9-]+')); }
    function audio(s) { return s is string && s.matches('assets/audio/(flip|correct|miss|drop|start)[.]mp3'); }
    function settings(c) { return c.keys().hasOnly(['schema','revision','pairCount','background','volume','back','sounds','types']) && c.schema == 1 && c.revision is int && c.revision > 0 && c.pairCount in [3,6,10] && c.background in ['transparent','green','white','black'] && c.volume is number && c.volume >= 0 && c.volume <= 100 && image(c.back) && c.sounds is map && c.sounds.keys().hasOnly(['flip','correct','miss','drop','start']) && audio(c.sounds.flip) && audio(c.sounds.correct) && audio(c.sounds.miss) && audio(c.sounds.drop) && audio(c.sounds.start) && c.types is list && c.types.size() > 0 && c.types.size() <= 10; }
    match /memorySettings/current {
      allow get: if true;
      allow create: if admin() && request.resource.data.revision == 1 && settings(request.resource.data);
      allow update: if admin() && request.resource.data.revision == resource.data.revision + 1 && settings(request.resource.data);
    }
    match /memoryImages/{id} {
      allow get: if true;
      allow list: if admin();
      allow create: if admin() && id.matches('slot([0-9]|[1-4][0-9])') && request.resource.data.keys().hasOnly(['name','version','data']) && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.version is string && request.resource.data.version.matches('[a-zA-Z0-9-]{1,64}') && request.resource.data.data is string && request.resource.data.data.size() <= 350000 && request.resource.data.data.matches('data:image/webp;base64,[A-Za-z0-9+/=]+');
      allow delete: if admin();
    }
    // Retired audience/slot collections and all unrelated paths are closed.
    match /{document=**} { allow read, write: if false; }
  }
}
